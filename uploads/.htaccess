# Never execute uploaded files as code.
Options -ExecCGI -Indexes
php_flag engine off
<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
AddType text/plain .php .phtml .phar
