# Secrets and local configuration — never commit real credentials.
/.env

# Runtime files.
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/uploads/*
!/uploads/.htaccess
!/uploads/.gitkeep

# Editors and OS metadata.
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Test/tooling artifacts.
.phpunit.result.cache
.php-cs-fixer.cache
