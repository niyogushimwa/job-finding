APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/job-finding
APP_NAME="JobLink Rwanda"
APP_TIMEZONE=Africa/Kigali
APP_DEFAULT_LANG=en

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_finding
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

MAIL_DRIVER=log
MAIL_FROM=hello@joblinkrwanda.rw
MAIL_FROM_NAME="JobLink Rwanda"

UPLOAD_MAX_SIZE=5242880
SESSION_NAME=joblink_session

# Optional: enable SMTP by setting MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
